# ------------------------------------------------------------
# 환경 변수 예시 — 복사해서 .env 로 사용 (cp .env.example .env)
# 실제 .env 는 절대 저장소에 올리지 않는다 (.gitignore 에 포함)
# ------------------------------------------------------------

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
# HTTPS 로 배포할 때만 true
SECURE_COOKIES=false
SECURE_HSTS=false

# 데모 모드 (시연용 시드 데이터·GIF 녹화 오버레이). 실제 운영에서는 false
DEMO_MODE=true

# PostgreSQL
POSTGRES_DB=evalplatform
POSTGRES_USER=evalplatform
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis (작업 큐 / 캐시)
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_URL=redis://redis:6379/1

# 파일 저장 위치 (컨테이너 내부 경로)
DATA_ROOT=/data

# 업로드 제한 (바이트)
MAX_CSV_BYTES=20971520
MAX_NOTEBOOK_BYTES=31457280
MAX_WEIGHTS_BYTES=524288000

# 마감 후 업로드 완료까지 허용하는 기본 유예 시간 (분)
DEFAULT_GRACE_MINUTES=30

# 샌드박스 (참여자 코드 격리 실행)
SANDBOX_IMAGE=evalplatform-sandbox:latest
SANDBOX_TIMEOUT_SECONDS=300
SANDBOX_MEMORY=2g
SANDBOX_CPUS=1.0
SANDBOX_PIDS_LIMIT=128
